PORT=3000
DATABASE_URL=postgres://stroyka:password@localhost:5432/stroyka

POSTGRES_USER=stroyka
POSTGRES_PASSWORD=
POSTGRES_DB=stroyka

# читает контейнер MinIO при первом запуске
MINIO_ROOT_USER=stroyka
MINIO_ROOT_PASSWORD=

# читает приложение. Локально ключи совпадают с root-парой выше,
# на проде — отдельный пользователь с правами только на свой бакет
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=stroyka
MINIO_SECRET_KEY=
MINIO_BUCKET=photos